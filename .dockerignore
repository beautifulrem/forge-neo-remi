# Build context of docker/Dockerfile (docker build -f docker/Dockerfile .): the code of this
# checkout, without user data, models, environments or build output. The image keeps all
# user data in its data folder (--data-dir /home/remi/data).
.git
.github
.vscode
.DS_Store
# other dotfiles and notes at the root (tool caches, local editor settings)
/.*
/*.md
**/*.log
**/__pycache__
**/*.pyc
/.uv-cache
/.coverage
/.coverage.*
/htmlcov
/.remi-workflows

# environments
/venv
/.venv

# user data of a local installation
/cache
/config.json
/config_states
/embeddings
/extension-data
/extensions
/models
/output
/outputs
/params.txt
/remi-data
/repositories
/styles.csv
/styles.csv.bak
/sysinfo*.json
/tmp
/ui-config.json
/user.css
/webui-user.bat
/webui-user.sh
/webui.settings.sh
/extensions-builtin/*/presets.json

# weights anywhere
**/*.bin
**/*.ckpt
**/*.gguf
**/*.onnx
**/*.pth
**/*.safetensors
**/*.sft

# the web interface: built in the image's webui stage
/webui/node_modules
/webui/dist
/webui/coverage
/webui/test-results
/webui/playwright-report
# local tool folders of webui/ (kept out of Git by .git/info/exclude, not .gitignore)
/webui/.impeccable

# tokenizers the launcher writes at start from the .xz archives next to them
# (backend/huggingface: Token, process()); the tracked Chroma tokenizer stays
/backend/huggingface/Wan-AI/Wan2.1-T2V-14B/tokenizer/tokenizer.json
/backend/huggingface/Wan-AI/Wan2.1-I2V-14B/tokenizer/tokenizer.json
/backend/huggingface/neta-art/Neta-Lumina/tokenizer/tokenizer.json
/backend/huggingface/nvidia/PiD/tokenizer/tokenizer.json
/backend/huggingface/Tongyi-MAI/Z-Image-Turbo/tokenizer/tokenizer.json
/backend/huggingface/black-forest-labs/FLUX.2-klein-4B/tokenizer/tokenizer.json
/backend/huggingface/black-forest-labs/FLUX.2-klein-9B/tokenizer/tokenizer.json
/backend/huggingface/circlestone-labs/Anima/tokenizer/tokenizer.json
/backend/huggingface/baidu/ERNIE-Image/tokenizer/tokenizer.json
/backend/huggingface/OpenMOSS-Team/MOSS-Image-SFT/tokenizer/tokenizer.json
/backend/huggingface/Qwen/Qwen3.5-4B/tokenizer/tokenizer.json
